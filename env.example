# Serverni ishga tushirish uchun bu faylni nusxalab, nomini ".env" ga o'zgartiring:
#   cp .env.example .env

PORT=3000

# Sessiya (JWT) tokenlarini imzolash uchun maxfiy kalit — ixtiyoriy uzun tasodifiy matn qo'ying
JWT_SECRET=bu_yerga_uzun_tasodifiy_matn_qoying

# Telegram bot orqali bildirishnoma
# 1) Telegram-da @BotFather ga yozib, /newbot buyrug'i bilan bot yarating va tokenni oling
# 2) @userinfobot ga yozib, o'z chat_id raqamingizni bilib oling
# 3) Quyidagilarni to'ldiring va ENABLE ni true qiling
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID
